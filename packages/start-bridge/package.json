{
  "name": "@tuturuuu/start-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Runs Next App Router satellite source on TanStack Start + Vite+ on Cloudflare: next/* shims, request context, proxy bridge, basePath contract and route registries.",
