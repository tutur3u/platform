    "./endpoints": "./src/core/endpoints.ts",
    "./api-forward": "./src/core/api-forward.ts",
    "./canary": "./src/core/canary.ts",
    "./csp": "./src/core/csp.ts",
    "./next/headers": "./src/next/headers.ts",
    "./next/server": "./src/next/server.ts",
    "./next/cache": "./src/next/cache.ts",
    "./next/navigation": "./src/next/navigation.tsx",
    "./next/navigation-document": "./src/next/navigation-document.tsx",
    "./next/link": "./src/next/link.tsx",
    "./next/image": "./src/next/image.tsx",
    "./next/dynamic": "./src/next/dynamic.tsx",
    "./next/cloudflare-context": "./src/next/cloudflare-context.ts",
    "./proxy-bridge": "./src/next/proxy-bridge.ts",
    "./function-proxy": "./src/next/function-proxy.ts",
    "./intl": "./src/intl/use-intl.tsx",
