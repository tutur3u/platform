    "./start/server-entry": "./src/start/server-entry.ts",
    "./vite": "./src/vite/preset.ts",
    "./codegen": "./src/codegen/registry.ts",
    "./pages": "./src/core/pages.ts",
    "./vite/rsc": "./src/vite/rsc.ts",
    "./start/page-route": "./src/start/page-route.tsx",
    "./start/page-render": "./src/start/page-render.tsx",
    "./start/page-params": "./src/start/page-params.ts",
    "./start/page-location": "./src/start/page-location.ts",
