{
  "name": "@tuturuuu/marketing-shell",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One marketing layout (navbar, footer, fonts, tokens) for every Tuturuuu marketing page, framework-agnostic.",
  "exports": {
    ".": "./src/index.ts",
    "./fonts.css": "./src/fonts.css",
    "./fonts/*": "./src/fonts/*",
    "./messages/en.json": "./src/messages/en.json",
    "./messages/vi.json": "./src/messages/vi.json",
    "./static-icons": "./src/static-icons.tsx",
    "./static-motion": "./src/use-static-motion.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*"
  },
  "peerDependencies": {
    "next-themes": "^0.4.6",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
