{
  "name": "@tuturuuu/supabase",
  "version": "0.6.0",
  "description": "Supabase client and utilities for Next.js applications with SSR support, cookie handling, and TypeScript type safety",
  "keywords": [
    "supabase",
    "nextjs",
    "ssr",
    "database",
    "authentication",
    "postgresql",
    "realtime",
    "typescript"
  ],
  "license": "MIT",
  "author": "Tuturuuu",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutur3u/platform",
    "directory": "packages/supabase"
  },
  "bugs": {
    "url": "https://github.com/tutur3u/platform/issues"
  },
  "homepage": "https://github.com/tutur3u/platform/tree/main/packages/supabase#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth-cookie-policy": {
      "types": "./dist/auth-cookie-policy.d.ts",
      "bun": "./src/auth-cookie-policy.ts",
      "default": "./dist/auth-cookie-policy.js"
    },
    "./auth-errors": {
      "types": "./dist/auth-errors.d.ts",
      "bun": "./src/auth-errors.ts",
      "default": "./dist/auth-errors.js"
    },
    "./shared-cookie-domains": {
      "types": "./dist/shared-cookie-domains.d.ts",
      "bun": "./src/shared-cookie-domains.ts",
      "default": "./dist/shared-cookie-domains.js"
    },
    "./next/client": {
      "types": "./dist/next/client.d.ts",
      "bun": "./src/next/client.ts",
      "default": "./dist/next/client.js"
    },
    "./next/auth-browser": {
      "types": "./dist/next/auth-browser.d.ts",
      "default": "./dist/next/auth-browser.js"
    },
    "./next/auth-session-user": {
      "types": "./dist/next/auth-session-user.d.ts",
      "bun": "./src/next/auth-session-user.ts",
      "default": "./dist/next/auth-session-user.js"
    },
    "./next/common": {
      "types": "./dist/next/common.d.ts",
      "bun": "./src/next/common.ts",
      "default": "./dist/next/common.js"
    },
    "./next/proxy": {
      "types": "./dist/next/proxy.d.ts",
      "bun": "./src/next/proxy.ts",
      "default": "./dist/next/proxy.js"
    },
    "./next/realtime-log-provider": {
      "types": "./dist/next/realtime-log-provider.d.ts",
      "bun": "./src/next/realtime-log-provider.tsx",
      "default": "./dist/next/realtime-log-provider.js"
    },
    "./request/server": {
      "types": "./dist/request/server.d.ts",
      "bun": "./src/request/server.ts",
      "default": "./dist/request/server.js"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "bun": "./src/next/server.ts",
      "default": "./dist/next/server.js"
    },
    "./next/user": {
      "types": "./dist/next/user.d.ts",
      "bun": "./src/next/user.ts",
      "default": "./dist/next/user.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./next/realtime-log-actions": {
      "types": "./dist/next/realtime-log-actions.d.ts",
      "bun": "./src/next/realtime-log-actions.ts",
      "default": "./dist/next/realtime-log-actions.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "type-check": "tsc --project tsconfig.typecheck.json",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@tuturuuu/types": "workspace:*",
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "next": "^16.4.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "next": ">=16.3.0",
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=18.0.0"
  }
}
