{
  "name": "@tuturuuu/editor",
  "version": "0.8.0",
  "description": "Lightweight localized rich-text editor and rendering utilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutur3u/platform",
    "directory": "packages/editor"
  },
  "type": "module",
  "files": ["dist", "README.md", "styles.css"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "type-check": "tsc --project tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@tiptap/extension-color": "3.30.0",
    "@tiptap/extension-highlight": "3.30.0",
    "@tiptap/extension-image": "3.30.0",
    "@tiptap/extension-link": "3.30.0",
    "@tiptap/extension-placeholder": "3.30.0",
    "@tiptap/extension-text-align": "3.30.0",
    "@tiptap/extension-text-style": "3.30.0",
    "@tiptap/react": "3.30.0",
    "@tiptap/starter-kit": "3.30.0",
    "lucide-react": "^1.31.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
