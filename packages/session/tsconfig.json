{
  "extends": "@tuturuuu/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "lib": ["ES2023", "WebWorker"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".turbo"]
}
