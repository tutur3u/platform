{
  "name": "@tuturuuu/types",
  "license": "MIT",
  "version": "0.37.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutur3u/platform",
    "directory": "packages/types"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --incremental",
    "type-check": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@tiptap/react": "3.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "require": "./dist/sdk.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js",
      "require": "./dist/primitives/*.js"
    },
    "./mastermind": {
      "types": "./dist/mastermind/ask-v2.d.ts",
      "import": "./dist/mastermind/ask-v2.js",
      "require": "./dist/mastermind/ask-v2.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "require": "./dist/db.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.js",
      "require": "./dist/supabase.js"
    },
    "./tiptap": {
      "types": "./dist/tiptap.d.ts",
      "import": "./dist/tiptap.js",
      "require": "./dist/tiptap.js"
    }
  },
  "packageManager": "bun@1.4.4"
}
