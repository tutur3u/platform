{
  "$comment": "Shrink-only allowlist enforced by scripts/ci/wrangler-usage-guard.test.js. Lower counts as usage is removed; a new entry or growth needs an \"admitted\" orchestrator decision reference. See apps/docs/build/development-tools/cf-cli-wrangler-parity.mdx.",
  "gaps": {
    "opennext-adapter": {
      "reason": "Parley and Lettin publish through @opennextjs/cloudflare, which reads wrangler.jsonc and invokes Wrangler; cf has no OpenNext adapter.",
      "owner": "Parley/Lettin TanStack Start on Void migration lane (orchestrator assigns)",
      "removal": "Delete when the app runs on Start + Void and publishes its exact artifact with cf deploy --prebuilt."
    },
    "parity-tooling": {
      "reason": "Migration tooling reads former wrangler.jsonc files and their normalized baselines to prove cf deployment-identity parity; it runs no Wrangler CLI and ships no Wrangler config.",
      "owner": "cf/Void Wrangler-exit lane",
      "removal": "Delete with the tooling once every native Worker is on cf and its production cutover is verified."
    },
    "paused-runtime": {
      "reason": "Retained paused runtimes (apps/backend, apps/tanstack-web) and their paused CI/tests; AGENTS.md forbids updating them during active work.",
      "owner": "Runtime resumption owner (orchestrator), see apps/docs/build/devops/active-runtime.mdx",
      "removal": "Migrate to cf + Void when the runtime resumes, or delete with the runtime when it is retired."
    },
    "pending-migration": {
      "reason": "Native Worker with no cf capability gap for its operations, awaiting its per-service parity PR (Durable Object migrations need manual exports conversion and a disposable rehearsal).",
      "owner": "cf/Void Wrangler-exit lane",
      "removal": "Delete in the service PR that moves it to cloudflare.config.ts, cf types, Build Output parity and cf deploy --prebuilt."
    },
    "shared-toolchain": {
      "reason": "Root wrangler devDependency supplies the CLI for every remaining gap; trustedDependencies, .wrangler ignores and policy tests cover @cloudflare/vite-plugin 1.x, which depends on the wrangler library.",
      "owner": "cf/Void Wrangler-exit lane",
      "removal": "Delete when no other allowlist entry needs the Wrangler CLI and @cloudflare/vite-plugin 2.x (no wrangler dependency) is adopted."
    },
    "void-wave1-publication": {
      "reason": "Void deploy always rebuilds and provisions (--skip-build is static-only in Void 1.1.12 and 1.2.1), so Wave 1 Start + Void apps publish the exact Void-emitted config with Wrangler.",
      "owner": "Wave 1 native Start + Void lane",
      "removal": "Delete when Void builds emit a cf Build Output (or Void ships a prebuilt Worker deploy) and cf deploy --prebuilt publication is proven byte-identical."
    }
  },
