      "entryRoute": "/",
      "loginRoute": "/login",
      "paths": ["/", "/login", "/health", "/robots.txt", "/manifest.json"]
    },
    "tools": {
      "name": "tools",
      "description": "Developer utility tools",
      "entryRoute": "/",
      "loginRoute": "/",
      "paths": ["/", "/health", "/robots.txt", "/manifest.json"],
      "note": "No /login route: the Vercel deployment answers a soft 404 (HTTP 200) for it and the native Worker answers 404, so the login check uses the entry route."
    },
    "playground": {
      "name": "playground",
      "description": "Sandbox playground",
      "entryRoute": "/",
      "loginRoute": "/login",
