{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CutoverSmokeTable",
  "description": "Per-app route configuration table for cross-app cutover smoke harness (D15)",
  "version": "1.0.0",
  "apps": {
    "web": {
      "name": "web",
      "description": "Apex tuturuuu.com web platform",
      "entryRoute": "/",
      "loginRoute": "/login",
      "paths": ["/", "/login", "/pricing", "/about", "/robots.txt"]
    },
    "marketing": {
      "name": "marketing",
      "description": "Marketing and public surface (TanStack Start + Vite+ + Void)",
      "entryRoute": "/",
      "loginRoute": "/login",
      "paths": ["/", "/login", "/pricing", "/about", "/robots.txt"]
    },
    "workspace": {
      "name": "workspace",
