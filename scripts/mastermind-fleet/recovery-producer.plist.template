<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tuturuuu.fleet-recovery-producer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_ABSOLUTE_PATH__</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>__FLEET_SYNC_ROOT__/bin/recovery-producer.mjs</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>WorkingDirectory</key>
  <string>__FLEET_SYNC_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__FLEET_SYNC_ROOT__/logs/recovery-producer.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__FLEET_SYNC_ROOT__/logs/recovery-producer.log</string>
</dict>
</plist>
