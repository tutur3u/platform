{
  "version": 2,
  "status": "draft-disabled",
  "zone": "tuturuuu.com",
  "plan": "Pro",
  "excludedHosts": ["finance.tuturuuu.com", "finance-staging.tuturuuu.com"],
  "applicationHosts": [
    "tuturuuu.com",
    "www.tuturuuu.com",
    "beta.tuturuuu.com",
    "staging.tuturuuu.com",
    "canary.tuturuuu.com",
    "vercel.tuturuuu.com",
    "next.tuturuuu.com",
    "ai.tuturuuu.com",
    "apps.tuturuuu.com",
    "calendar.tuturuuu.com",
    "chat.tuturuuu.com",
    "cms.tuturuuu.com",
    "colab.tuturuuu.com",
    "contacts.tuturuuu.com",
    "drive.tuturuuu.com",
    "forms.tuturuuu.com",
    "git.tuturuuu.com",
    "hive.tuturuuu.com",
    "infrastructure.tuturuuu.com",
    "inventory.tuturuuu.com",
    "learn.tuturuuu.com",
    "lettin.tuturuuu.com",
    "mail.tuturuuu.com",
    "meet.tuturuuu.com",
    "mind.tuturuuu.com",
    "noah.tuturuuu.com",
    "nova.tuturuuu.com",
    "parley.tuturuuu.com",
    "pay.tuturuuu.com",
    "shortener.tuturuuu.com",
    "storefront.tuturuuu.com",
    "storefronts.tuturuuu.com",
    "tasks.tuturuuu.com",
    "teach.tuturuuu.com",
    "tools.tuturuuu.com",
    "track.tuturuuu.com",
    "store.tuturuuu.com",
    "stores.tuturuuu.com",
    "api.tuturuuu.com"
  ],
  "applicationMachinePrefixes": ["/api/", "/_next/static/", "/.well-known/"],
  "applicationMachineExact": [
    "/api",
    "/verify-token",
    "/robots.txt",
    "/sitemap.xml",
    "/manifest.webmanifest",
    "/site.webmanifest",
    "/sw.js"
  ],
  "serviceMachines": [
    {
      "host": "meet-realtime.tuturuuu.com",
      "exact": [
        "/health",
        "/realtime",
        "/room-state",
        "/room-device",
        "/room-service",
        "/channels",
        "/channels/publish",
        "/channels/document",
        "/collaboration",
        "/collaboration/seed",
        "/collaboration/checkpoint",
        "/collaboration/runner-files"
      ],
      "prefixes": []
    },
    {
      "host": "colab.tuturuuu.com",
      "exact": ["/auth/login", "/auth/callback"],
      "prefixes": []
    },
    {
      "host": "hive.tuturuuu.com",
      "exact": ["/realtime"],
      "prefixes": []
    }
  ],
  "probe": {
    "hosts": ["meet.tuturuuu.com"],
    "methods": ["GET", "HEAD"],
    "paths": ["/api/build-info", "/", "/en", "/vi"],
    "header": "x-tuturuuu-edge-probe",
    "secretPlaceholders": [
      "__EDGE_PROBE_SECRET_CURRENT_REQUIRED__",
      "__EDGE_PROBE_SECRET_NEXT_REQUIRED__"
    ],
    "stripBeforeOrigin": true,
    "rotation": {
      "maxAcceptedValues": 2,
      "overlapMinutes": 10,
      "classification": "low-value-rotating-transport-exemption",
      "rulesetReadersCanReadPlaintext": true
    }
  },
  "rateLimit": {
    "hosts": [
      "colab.tuturuuu.com",
      "hive.tuturuuu.com",
      "lettin.tuturuuu.com",
      "meet.tuturuuu.com",
      "parley.tuturuuu.com"
    ],
    "prefixes": ["/api/v1/auth/", "/api/auth/", "/api/cli/auth/"],
    "characteristics": ["ip.src", "cf.colo.id"],
    "period": 60,
    "requestsPerPeriod": 20,
    "mitigationTimeout": 60,
    "existingRuleCount": 1,
    "maximumRuleCount": 2,
    "mode": "low-threshold-auth-candidate",
    "client429AcceptanceRequired": true
  },
  "prerequisites": [
    "Independent security review and explicit provider-write admission; this proposal authorizes neither.",
    "Refresh DNS, phase entrypoints, quota, managed actions and Finance custody immediately before any rollout.",
    "Verify each candidate host belongs to its named app; aliases and external projects require owner acceptance.",
    "Keep every compiled rule disabled until a separately reviewed rollout change.",
    "No zone-wide bot, crawler, Labyrinth or DNS change is included; those could affect Finance.",
    "Resolve managed-rule challenge actions for each machine route with narrow rule-ID exceptions before claiming challenge-free delivery.",
    "Per-token limits remain authenticated application responsibilities; Pro edge counters are per IP and colo.",
    "Probe secret must be independently provisioned and substituted privately; never enable the placeholder.",
    "Existing webhook signature checks and origin authentication remain required for every skip match.",
    "R2 storage and unknown/custom external host ownership must be established before extending selectors.",
    "Origin lock, current URL normalization scope both, and controlled client 429 acceptance are required before enforcing the low auth limit or browser controls.",
    "Re-read the custom entrypoint; preserve the Finance-owned TEMP rule and its position, and capture every new rule ID and relative position.",
    "Probe values are plaintext to ruleset readers; rotate low-value values with at most two accepted values during a bounded overlap, and strip the header in late request transforms.",
    "No blanket Block AI Bots exception is established by an SBFM-only skip; resolve actual AI policy behavior per admitted machine path before applying."
  ],
  "urlNormalization": {
    "type": "cloudflare",
    "scope": "both",
    "reReadBeforeApply": true
  },
  "originLock": {
    "requiredBeforeEnforcement": true,
    "workersDev": false,
    "previewUrls": false,
    "workerConfigPaths": [
      "apps/meet-realtime/wrangler.jsonc",
      "apps/lettin/wrangler.jsonc",
      "apps/parley/wrangler.jsonc"
    ],
    "vercel": {
      "requireCloudflareSourceNetwork": true,
      "requireEdgeInjectedSecret": true,
      "secretHeader": "x-tuturuuu-edge-origin",
      "overwriteClientHeader": true,
      "protectAllDeploymentAliases": true,
      "aliasPattern": "<app>-tuturuuu.vercel.app"
    },
    "reReadBeforeApply": true
  },
  "entrypointCustody": {
    "reReadBeforeApply": true,
    "preserveForeignRules": true,
    "captureRuleIdsAndPositions": true,
    "skipBeforeBlockOrChallenge": true,
    "financeOwnerApprovalRequired": true
  },
  "behaviorAcknowledgements": {
    "browserBicAlreadyOn": true,
    "machineSecurityLevelOffBypassesUnderAttack": true,
    "sbfmSkipDoesNotProveAllAiPolicyBypass": true
  }
}
