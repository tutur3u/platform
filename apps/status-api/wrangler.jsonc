{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // DES-TTR-UPTIME v2 PR 1. Placeholder binding names only: no account,
  // namespace ids, routes or deploy wiring; Release Desk owns provisioning.
  "name": "tuturuuu-status-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "limits": { "cpu_ms": 10 },
  // Read-only snapshot store. Empty ID lists publish nothing (default deny);
  // the STATUS_NEVER_PUBLIC_IDS secret is held outside the repo.
  "kv_namespaces": [{ "binding": "STATUS_SNAPSHOTS" }],
  "vars": { "STATUS_PUBLIC_COMPONENT_IDS": "", "STATUS_CLIENT_CONSENT_IDS": "" }
}
