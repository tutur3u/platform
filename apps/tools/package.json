{
  "name": "@tuturuuu/tools",
  "version": "0.19.0",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7825} --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 7825 --turbopack"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "@tuturuuu/vercel": "workspace:*",
    "next": "^16.3.5",
    "next-intl": "^4.14.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.4.1",
  "portless": {
    "name": "tools.tuturuuu",
    "script": "dev:app"
  }
