# Dormant template only. Do not deploy this file or put credentials in it.
# Host: web.staging.tutur3u.com; zone: tutur3u.com.
WEB_START_CANDIDATE=off
WEB_START_NATIVE_LEGAL=off
AUTH_COOKIE_DOMAIN=.staging.tutur3u.com
NEXT_PUBLIC_SUPABASE_URL=<owner-verified-staging-supabase-url>
NEXT_FALLBACK_ORIGIN=<owner-verified-immutable-staging-next-origin>
# Secret-store inputs (names only; never substitute into a tracked file):
# CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN (scoped account Workers + tutur3u.com zone)
# TRUSTED_PROXY_ORIGIN_SECRET (staging-only, distinct from production)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SECRET_KEY (fallback only; no database binding for legal pages)
# TURNSTILE_SECRET_KEY / NEXT_PUBLIC_TURNSTILE_SITE_KEY (staging login)
# R2 account/bucket/access credentials (fallback storage only)
