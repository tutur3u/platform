    "workerName": "tuturuuu-shortener-vite-staging",
    "workersDev": true,
    "vars": { "TUTURUUU_NOINDEX": "1" }
  },
  "production": {
    "workerName": "tuturuuu-shortener",
    "workersDev": false,
    "vars": {
      "SHORTENER_CANONICAL_HOST_ENABLED": "1",
