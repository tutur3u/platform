{
  "name": "@tuturuuu/shortener",
  "version": "0.25.0",
  "private": true,
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- vp dev --host 127.0.0.1 --port ${PORT:-3002}",
    "devx": "bun sb:stop && bun sb:start && bun dev",
    "devrs": "bun sb:stop && bun sb:start && bun sb:reset && bun dev",
    "build": "vp build",
    "start": "vp preview --host 127.0.0.1 --port ${PORT:-3002}",
    "preview": "vp preview --host 127.0.0.1 --port ${PORT:-3002}",
    "build:cloudflare": "vp build",
    "test": "vp test run --config vitest.config.ts",
    "test:runtime": "node --test cloudflare/native-built-worker.test.mjs",
    "stop": "cd ../database && bun sb:stop",
    "sb:status": "cd ../database && bun sb:status",
    "sb:start": "cd ../database && bun sb:start",
    "sb:stop": "cd ../database && bun sb:stop",
    "sb:sync": "cd ../database && bun sb:sync",
    "sb:reset": "cd ../database && bun sb:reset",
    "sb:diff": "cd ../database && bun sb:diff",
    "sb:new": "cd ../database && bun sb:new",
    "sb:up": "cd ../database && bun sb:up",
    "sb:typegen": "cd ../database && bun sb:typegen",
    "ui:add": "bunx shadcn-ui@latest add",
    "ui:diff": "bunx shadcn-ui@latest diff"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tuturuuu/ai": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "bcryptjs": "3.0.3",
    "dayjs": "^1.11.23",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.31",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "shortener.tuturuuu",
    "script": "dev:app"
  }
}
