{
  "appDir": "src/app",
  "api": {
    "out": "src/start-bridge/api-registry.bridge.gen.ts",
    "patternsOut": "src/start-bridge/api-patterns.bridge.gen.ts",
    "lazy": true
  },
  "pages": {
    "out": "src/start-bridge/page-registry.bridge.gen.ts"
  },
  "stripSegments": {
    "[locale]": {
      "locale": "en"
    }
  },
  "owned": {},
  "ignored": {},
  "runtime": {
    "/": {
      "redirect": "/login"
    }
  },
  "runtimeProbes": {
    "page": {
      "skip": "every page redirects signed-out users to login",
      "fixture": "cloudflare/auth-redirect.runtime.mjs"
    },
    "notFound": {
      "skip": "unknown paths redirect signed-out users to login",
      "fixture": "cloudflare/auth-redirect.runtime.mjs"
    },
    "api": {
      "path": "/api/build-info",
      "anonymousStatus": 401,
      "fixture": "cloudflare/build-info-admin.runtime.mjs"
    }
  }
}
