{
  "name": "@tuturuuu/nova",
  "version": "0.43.0",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7805} --turbopack",
    "devx": "bun sb:stop && bun sb:start && bun dev",
    "devrs": "bun sb:stop && bun sb:start && bun sb:reset && bun dev",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 7805 --turbopack",
    "test": "vitest run",
    "test:watch": "vitest",
    "stop": "cd ../database && bun sb:stop",
    "sb:status": "cd ../database && bun sb:status",
    "sb:start": "cd ../database && bun sb:start",
    "sb:stop": "cd ../database && bun sb:stop",
    "sb:sync": "cd ../database && bun sb:sync",
    "sb:reset": "cd ../database && bun sb:reset",
    "sb:diff": "cd ../database && bun sb:diff",
    "sb:new": "cd ../database && bun sb:new",
    "sb:up": "cd ../database && bun sb:up",
    "sb:typegen": "cd ../database && bun sb:typegen",
    "ui:add": "bunx shadcn-ui@latest add",
    "ui:diff": "bunx shadcn-ui@latest diff",
    "build:cloudflare": "vp build --configLoader runner",
    "dev:cloudflare": "vp dev --configLoader runner --host 127.0.0.1 --port ${PORT:-7805}",
    "preview:cloudflare": "vp preview --configLoader runner --host 127.0.0.1 --port ${PORT:-7805}",
    "routes:check": "bun ../../packages/start-bridge/src/codegen/cli.ts check .",
    "type-check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "test:runtime": "node --test cloudflare/*.runtime.mjs"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "0.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tuturuuu/ai": "workspace:*",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/start-bridge": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "@tuturuuu/vercel": "workspace:*",
    "@upstash/qstash": "^2.12.1",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "framer-motion": "^13.5.1",
    "jotai": "^3.0.1",
    "juice": "^12.2.0",
    "lodash": "4.18.1",
    "moment": "^2.31.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "sharp": "^0.35.5",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/uuid": "^11.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "^5.0.5",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "nova.tuturuuu",
    "script": "dev:app"
  }
}
