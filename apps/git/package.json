{
  "name": "@tuturuuu/git",
  "version": "0.15.0",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7830} --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 7830 --turbopack",
    "build:cloudflare": "vp build --configLoader runner",
    "dev:cloudflare": "vp dev --configLoader runner --host 127.0.0.1 --port ${PORT:-7830}",
    "preview:cloudflare": "vp preview --configLoader runner --host 127.0.0.1 --port ${PORT:-7830}",
    "routes:check": "bun ../../packages/start-bridge/src/codegen/cli.ts check .",
    "type-check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "test:runtime": "node --test cloudflare/*.runtime.mjs",
    "build:legacy": "next build --turbopack"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@octokit/auth-app": "^8.3.1",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/start-bridge": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "negotiator": "^1.1.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "streamdown": "^2.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "^5.0.5",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "portless": {
    "name": "git.tuturuuu",
    "script": "dev:app"
  }
}
