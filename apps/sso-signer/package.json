{
  "name": "@tuturuuu/sso-signer-worker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node scripts/check-build-output.mjs",
    "test": "vp test",
    "type-check": "cf workers types && tsc --project tsconfig.json",
    "lint": "vp lint --config .oxlintrc.json src scripts vite.config.ts vitest.config.ts cloudflare.config.ts --deny-warnings",
    "format:check": "vp fmt --config .oxfmtrc.json src scripts vite.config.ts vitest.config.ts cloudflare.config.ts --check"
  },
  "dependencies": {
    "@tuturuuu/sso": "workspace:*",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/node": "26.6.5",
    "@xmldom/xmldom": "0.9.12",
    "cf": "1.0.0-beta.20",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  }
}
