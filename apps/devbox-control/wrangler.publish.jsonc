{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tuturuuu-devbox-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-28",
  "account_id": "e8912e2867beecc673d171907bf09649",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "invocation_logs": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER_WAKE",
        "class_name": "RunnerWake"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RunnerWake"]
    }
  ],
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SECRET_KEY",
      "DEVBOX_CONTROL_INTERNAL_TOKEN"
    ]
  },
  "vars": {
    "TUTURUUU_DEVBOX_AGENT_API_ENABLED": "true",
    "TUTURUUU_DEVBOX_EXPIRY_SWEEP_ENABLED": "false"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "preview_urls": true
}
