{
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wrangler": "4.149.0"
  },
  "name": "@tuturuuu/meet-realtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 8786",
    "build": "vp build",
    "lint": "vp lint --config .oxlintrc.json src/worker.ts vite.config.ts --deny-warnings",
    "format:check": "vp fmt --config .oxfmtrc.json vite.config.ts scripts --check",
    "test:runtime": "node --test scripts/verify-worker-runtime.mjs",
    "type-check": "tsc --project tsconfig.json",
    "test:protocol": "node --test src/check-endpoint.test.ts src/check-socket.test.ts src/turn-credentials.test.ts"
  }
}
