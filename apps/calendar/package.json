{
  "name": "@tuturuuu/calendar",
  "version": "0.36.0",
  "private": true,
  "scripts": {
    "type-check": "bun run type-check:app && bun run type-check:boundary && bun run type-check:worker && bun run type-check:sw",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- vp dev --port ${PORT:-7806}",
    "devx": "bun sb:stop && bun sb:start && bun dev",
    "devrs": "bun sb:stop && bun sb:start && bun sb:reset && bun dev",
    "build": "vp build",
    "start": "vp preview --port 7806",
    "preview": "vp preview --port 7806",
    "stop": "cd ../database && bun sb:stop",
    "sb:status": "cd ../database && bun sb:status",
    "sb:start": "cd ../database && bun sb:start",
    "sb:stop": "cd ../database && bun sb:stop",
    "sb:sync": "cd ../database && bun sb:sync",
    "sb:reset": "cd ../database && bun sb:reset",
    "sb:diff": "cd ../database && bun sb:diff",
    "sb:new": "cd ../database && bun sb:new",
    "sb:up": "cd ../database && bun sb:up",
    "sb:typegen": "cd ../database && bun sb:typegen",
    "ui:add": "bunx shadcn-ui@latest add",
    "ui:diff": "bunx shadcn-ui@latest diff",
    "test": "vitest run",
    "build:legacy": "next build --turbopack",
    "cf:typegen": "node ../../scripts/ci/calendar-cf-types.mjs",
    "type-check:app": "tsc --noEmit --project tsconfig.json",
    "type-check:boundary": "tsc --project tsconfig.boundary.json",
    "type-check:worker": "tsc --noEmit --project tsconfig.worker.json",
    "type-check:sw": "tsc --noEmit --project tsconfig.sw.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tuturuuu/ai": "workspace:*",
    "@tuturuuu/apis": "workspace:*",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/google": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/microsoft": "workspace:*",
    "@tuturuuu/offline": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/tasks-ui": "workspace:*",
    "@tuturuuu/trigger": "workspace:*",
    "@tuturuuu/turnstile": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "@tuturuuu/vercel": "workspace:*",
    "cmdk": "^1.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "entities": "^8.1.0",
    "framer-motion": "^13.5.1",
    "nanoid": "^6.0.2",
    "negotiator": "^1.1.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
