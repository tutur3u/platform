{
  "extends": "@tuturuuu/typescript-config/nextjs.json",
  "compilerOptions": {
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"],
      "@tuturuuu/tasks-ui/tu-do/boards/boardId/task-board-page-model": [
        "../../packages/tasks-ui/src/tu-do/boards/boardId/task-board-page-model.ts"
      ]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": [
    "src",
    "cloudflare",
    "cloudflare-env.d.ts",
    "vite.config.ts",
    "void.config.ts",
    "global.d.ts",
    "messages"
  ],
  "exclude": ["node_modules", "dist", ".turbo"]
}
