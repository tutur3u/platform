{
  "name": "@tuturuuu/playground",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "test": "vitest run",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-3003} --turbopack",
    "devx": "bun sb:stop && bun sb:start && bun dev",
    "devrs": "bun sb:stop && bun sb:start && bun sb:reset && bun dev",
    "build": "vp build --configLoader runner",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 3003 --turbopack",
    "stop": "cd ../database && bun sb:stop",
    "sb:status": "cd ../database && bun sb:status",
    "sb:start": "cd ../database && bun sb:start",
    "sb:stop": "cd ../database && bun sb:stop",
    "sb:sync": "cd ../database && bun sb:sync",
    "sb:reset": "cd ../database && bun sb:reset",
    "sb:diff": "cd ../database && bun sb:diff",
    "sb:new": "cd ../database && bun sb:new",
    "sb:up": "cd ../database && bun sb:up",
    "sb:typegen": "cd ../database && bun sb:typegen",
    "ui:add": "bunx shadcn-ui@latest add",
    "ui:diff": "bunx shadcn-ui@latest diff",
    "build:cloudflare": "vp build --configLoader runner",
    "dev:cloudflare": "vp dev --configLoader runner --host 127.0.0.1 --port ${PORT:-3003}",
    "preview:cloudflare": "vp preview --configLoader runner --host 127.0.0.1 --port ${PORT:-3003}",
    "routes:check": "bun ../../packages/start-bridge/src/codegen/cli.ts check .",
    "type-check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "test:runtime": "node --test cloudflare/*.runtime.mjs",
    "build:legacy": "next build --turbopack"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.102",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tuturuuu/ai": "workspace:*",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/start-bridge": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "dayjs": "^1.11.23",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.31",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "^5.0.5",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "playground.tuturuuu",
    "script": "dev:app"
  }
}
