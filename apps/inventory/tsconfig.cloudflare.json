{
  "$comment": "Generated by the start-bridge codemod for inventory; re-run it instead of editing.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "plugins": [],
    "types": ["vite/client", "node"]
  },
  "include": ["src", "cloudflare", "global.d.ts", "messages", "void.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    ".next",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest.setup.ts"
  ]
}
