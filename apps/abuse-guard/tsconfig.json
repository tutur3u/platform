{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    ".cloudflare/types/index.d.ts",
    "cloudflare.config.ts",
    "src/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
