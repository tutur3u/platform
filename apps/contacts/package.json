{
  "name": "@tuturuuu/contacts",
  "version": "0.30.0",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7827} --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 7827 --turbopack",
    "build:candidate": "cd cloudflare && node prepare-build.mjs && vp build --config ../vite.config.mts --configLoader runner",
    "test:candidate": "cd ../.. && vitest run --config apps/contacts/cloudflare/vitest.config.mts",
    "type-check:candidate": "tsc --noEmit -p tsconfig.candidate.json",
    "routes:candidate": "bun cloudflare/generate-inventory.ts",
    "routes:candidate:check": "bun cloudflare/generate-inventory.ts --check",
    "test:candidate:runtime": "node --test cloudflare/emitted.runtime.mjs",
    "test:staging:policy": "node --experimental-strip-types --test e2e-staging/policy.test.ts",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "test:candidate:controls": "node cloudflare/controls.mjs"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@mantine/hooks": "^9.7.3",
    "@react-email/render": "^2.1.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/react": "^3.32.0",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/start-bridge": "workspace:*",
    "@tuturuuu/storage-core": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/transactional": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/users-core": "workspace:*",
    "@tuturuuu/users-ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "html2canvas-pro": "^2.5.2",
    "jotai": "^3.0.1",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "negotiator": "^1.1.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-papaparse": "^4.4.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "7.29.8",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/dompurify": "^3.2.0",
    "@types/lodash": "^4.17.27",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "^5.0.5",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "portless": {
    "name": "contacts.tuturuuu",
    "script": "dev:app"
  }
}
