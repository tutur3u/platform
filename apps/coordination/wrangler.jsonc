{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tuturuuu-coordination",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "e8912e2867beecc673d171907bf09649",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "durable_objects": {
    "bindings": [{ "name": "COORDINATION", "class_name": "CoordinationObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoordinationObject"] }],
  "secrets": { "required": ["COORDINATION_TOKEN"] }
}
