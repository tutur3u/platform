{
  "extends": "@tuturuuu/typescript-config/nextjs.json",
  "compilerOptions": {
    "module": "ESNext",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@tuturuuu/types/*": ["../../packages/types/src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src", ".next/types/**/*.ts", "global.d.ts", "messages"],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "cloudflare",
    "src/routeTree.gen.ts",
    "src/router.tsx",
    "src/routes",
    "src/start-bridge",
    "src/start.ts",
    "vite.config.mts",
    "void.config.ts"
  ]
}
