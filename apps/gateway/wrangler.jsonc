{
  // Gateway Worker for tuturuuu.com. The provider owner attaches the route;
  // CI uploads versions (web-opennext.yaml, gateway job) from this file merged
  // with the live Worker's variables and service bindings. See
  // apps/docs/build/devops/gateway-worker.mdx.
  "name": "tuturuuu-gateway",
  "account_id": "e8912e2867beecc673d171907bf09649",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-28",
  // Same-zone fetches go through the public path so zone Worker routes apply.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tuturuuu.com/*", "zone_name": "tuturuuu.com" }],
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": true, "head_sampling_rate": 0.01 },
  "vars": {
    // Unread by the Worker: the deploy parity tooling still requires the
    // name. There is no passthrough mode; rollback is a previous gateway
    // version.
    "GATEWAY_MODE": "active",
    // Public hostname clients see; Marketing origin redirects to its own host
    // are rewritten to it. Web has no HTTP origin: its family Workers serve it
    // over service bindings, and without the web-rest binding the gateway
    // answers 503.
    "PUBLIC_HOST": "tuturuuu.com",
    // Comma-separated page groups served by the apps/marketing Worker (legal,
    // company, products, solutions, blog, home). Every deploy from this file
    // applies this value. Empty keeps every page on the web families; removing a
    // group is the one-flag rollback for that group.
    "GATEWAY_MARKETING_GROUPS": "legal,company,products,solutions,blog,home",
    // "1" releases the exact private robots value on canonical Marketing pages
    // sent without the provenance marker by Marketing Worker builds that
    // predate it. Remove once the live Marketing Worker sends the marker.
    "GATEWAY_MARKETING_LEGACY_ROBOTS": "1",
    // Origin of the apps/marketing Worker (value set at deploy time).
    // "MARKETING_ORIGIN": "https://<marketing worker hostname>",
    "GATEWAY_RESPECT_ORIGIN_CACHE_CONTROL": "false",
    // Mounts of apps served at tuturuuu.com/<app>: "/learn" hands the bare
    // path (any query) to the service binding MOUNT_<SEGMENT>; "/learn/*" also
    // hands it nested paths. Empty: every path stays on the web families. Removing an
    // app's entries (with its zone routes) is that app's one-step rollback.
    // This list is the committed inventory of LIVE mounts: Web's active-mount
    // list (scripts/active-app-mounts.mjs) is derived from it, and Web returns
    // a login to /<app>/verify-token only for listed apps. Commit a mount only
    // after, or in the same change as, the gateway write that makes it live;
    // `node scripts/active-app-mounts.mjs --live <version.json>` fails when a
    // committed path is not live.
    "GATEWAY_MOUNTED_PATHS": "/learn,/nova,/nova/*,/roadmap,/tools,/tools/*,/teach,/teach/*,/lms,/lms/*,/admin,/admin/*,/meet,/meet/*,/mail,/mail/*,/contacts,/contacts/*,/calendar,/calendar/*,/apps,/apps/*,/finance,/finance/*",
    // Comma-separated apps/web route families (manifest `webFamilies`) served
    // by their own Worker through the binding WEB_FAMILY_<ID>. A family needs
    // both its id here and its binding; otherwise its paths go to the
    // fallback family web-rest (WEB_FAMILY_WEB_REST), which needs only its
    // binding.
    "GATEWAY_WEB_FAMILIES": "",
  },
  // Worker secrets the deploy requires on the live gateway (names only; values
  // are set in the Worker secret store). TRUSTED_PROXY_ORIGIN_SECRET signs the
  // visitor IP for Web's TRUSTED_PROXY=cloudflare-origin and must equal Web's
  // TRUSTED_PROXY_ORIGIN_SECRET.
  "secrets": { "required": ["TRUSTED_PROXY_ORIGIN_SECRET"] },
  // One service binding per mounted app, added at that app's cutover. Learn's
  // nested paths are zone routes on tuturuuu-learn; the gateway mount covers
  // the bare path with a query string, which a zone route cannot match. Nova
  // is mounted for the bare path and every nested path.
  "services": [
    { "binding": "MOUNT_LEARN", "service": "tuturuuu-learn" },
    { "binding": "MOUNT_NOVA", "service": "tuturuuu-nova" },
    { "binding": "MOUNT_ROADMAP", "service": "tuturuuu-roadmap" },
    { "binding": "MOUNT_TOOLS", "service": "tuturuuu-tools" },
    { "binding": "MOUNT_TEACH", "service": "tuturuuu-teach" },
    { "binding": "MOUNT_LMS", "service": "tuturuuu-lms" },
    { "binding": "MOUNT_ADMIN", "service": "tuturuuu-infrastructure" },
    { "binding": "MOUNT_MEET", "service": "tuturuuu-meet" },
    { "binding": "MOUNT_MAIL", "service": "tuturuuu-mail" },
    { "binding": "MOUNT_CONTACTS", "service": "tuturuuu-contacts" },
    { "binding": "MOUNT_CALENDAR", "service": "tuturuuu-calendar" },
    { "binding": "MOUNT_APPS", "service": "tuturuuu-apps" },
    { "binding": "MOUNT_FINANCE", "service": "tuturuuu-finance" },
  ],
  // One service binding per web family, added at that family's cutover. The
  // family Worker has no routes of its own:
  // "services": [
  //   { "binding": "WEB_FAMILY_API_IDENTITY", "service": "tuturuuu-web-api-identity" },
  // ],
}
