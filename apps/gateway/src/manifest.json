{
  "locales": ["en", "vi"],
  "origins": {
    "web": { "env": "WEB_ORIGIN" }
  },
  "default": { "origin": "web", "cache": "bypass" },
  "routes": [
    {
      "id": "marketing-pages",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": [
        "/",
        "/about",
        "/acceptable-use",
        "/blog",
        "/branding",
        "/careers",
        "/changelog",
        "/community-guidelines",
        "/contact",
        "/contributors",
        "/download",
        "/meet",
        "/meet-together",
        "/models",
        "/partners",
        "/portfolio",
        "/pricing",
        "/privacy",
        "/products",
        "/qr-generator",
        "/security",
        "/terms",
        "/women-in-tech"
      ],
      "prefix": [
        "/blog/",
        "/changelog/",
        "/legal/",
        "/products/",
        "/security/",
        "/solutions/",
        "/visualizations/"
      ]
    },
    {
      "id": "satellite-landings",
      "origin": "web",
      "cache": "page",
      "localized": false,
      "exact": ["/roadmap", "/design"],
      "prefix": ["/roadmap/", "/design/"]
    },
    {
      "id": "seo-metadata",
      "origin": "web",
      "cache": "page",
      "localized": false,
      "exact": [
        "/robots.txt",
        "/sitemap.xml",
        "/manifest.webmanifest",
        "/manifest.json"
      ],
      "prefix": ["/.well-known/"]
    },
    {
      "id": "static-assets",
      "origin": "web",
      "cache": "static",
      "localized": false,
      "exact": [
        "/favicon.ico",
        "/favicon-16x16.png",
        "/favicon-32x32.png",
        "/apple-touch-icon.png",
        "/android-chrome-192x192.png",
        "/android-chrome-512x512.png",
        "/icon-192x192.png",
        "/icon-512x512.png",
        "/logo.svg",
        "/cover.png",
        "/wallpaper.jpg"
      ],
      "prefix": ["/_next/static/", "/media/", "/screenshots/"]
    }
  ]
}
