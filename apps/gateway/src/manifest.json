{
  "locales": ["en", "vi"],
  "origins": {
    "web": {
      "env": "WEB_ORIGIN"
    },
    "marketing": {
      "env": "MARKETING_ORIGIN"
    }
  },
  "default": {
    "origin": "web",
    "cache": "bypass"
  },
  "routes": [
    {
      "id": "marketing-legal",
      "group": "legal",
      "flagOrigin": "marketing",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": [
        "/privacy",
        "/terms",
        "/acceptable-use",
        "/community-guidelines",
        "/security"
      ],
      "prefix": ["/legal/", "/security/"]
    },
    {
      "id": "marketing-company",
      "group": "company",
      "flagOrigin": "marketing",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": [
        "/about",
        "/branding",
        "/careers",
        "/contact",
        "/contributors",
        "/partners",
        "/women-in-tech"
      ],
      "prefix": []
    },
    {
      "id": "web-meet-product",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": ["/products/meet"],
      "prefix": ["/products/meet/"]
    },
    {
      "id": "marketing-products",
      "group": "products",
      "flagOrigin": "marketing",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": ["/products"],
      "prefix": ["/products/"]
    },
    {
      "id": "marketing-solutions",
      "group": "solutions",
      "flagOrigin": "marketing",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": [],
      "prefix": ["/solutions/"]
    },
    {
      "id": "marketing-blog",
      "group": "blog",
      "flagOrigin": "marketing",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": ["/blog"],
      "prefix": ["/blog/"]
    },
    {
      "id": "marketing-home",
      "group": "home",
      "flagOrigin": "marketing",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": ["/", "/pricing"],
      "prefix": []
    },
    {
      "id": "marketing-pages",
      "origin": "web",
      "cache": "page",
      "localized": true,
      "exact": [
        "/changelog",
        "/download",
        "/meet",
        "/meet-together",
        "/models",
        "/portfolio",
        "/qr-generator"
      ],
      "prefix": ["/changelog/", "/visualizations/"]
    },
    {
      "id": "satellite-landings",
      "origin": "web",
      "cache": "page",
      "localized": false,
      "exact": ["/roadmap", "/design"],
      "prefix": ["/roadmap/", "/design/"]
    },
    {
      "id": "seo-metadata",
      "origin": "web",
      "cache": "page",
      "localized": false,
      "exact": [
        "/robots.txt",
        "/sitemap.xml",
        "/manifest.webmanifest",
        "/manifest.json"
      ],
      "prefix": ["/.well-known/"]
    },
    {
      "id": "marketing-assets",
      "origin": "marketing",
      "cache": "static",
      "localized": false,
      "exact": [],
      "prefix": ["/assets/"]
    },
    {
      "id": "static-assets",
      "origin": "web",
      "cache": "static",
      "localized": false,
      "exact": [
        "/favicon.ico",
        "/favicon-16x16.png",
        "/favicon-32x32.png",
        "/apple-touch-icon.png",
        "/android-chrome-192x192.png",
        "/android-chrome-512x512.png",
        "/icon-192x192.png",
        "/icon-512x512.png",
        "/logo.svg",
        "/cover.png",
        "/wallpaper.jpg"
      ],
      "prefix": ["/_next/static/", "/media/", "/screenshots/"]
    }
  ],
  "webFamilies": {
    "deny": [
      "/api/v1/auth/accounts",
      "/api/notifications/send-immediate",
      "/api/cron",
      "/api/v1/infrastructure",
      "/api/v1/devboxes",
      "/api/v1/users/chatgpt",
      "/api/ai/chatgpt",
      "/_next/image"
    ],
    "families": [
      {
        "id": "public-docs",
        "binding": "WEB_FAMILY_PUBLIC_DOCS",
        "localized": true,
        "assetPrefix": "/_f/public-docs",
        "exact": ["/changelog", "/docs", "/ui"],
        "prefix": ["/changelog/", "/visualizations/", "/ui/"],
        "exclude": []
      },
      {
        "id": "api-identity",
        "binding": "WEB_FAMILY_API_IDENTITY",
        "localized": false,
        "assetPrefix": null,
        "exact": [
          "/api/build-info",
          "/api/health",
          "/api/auth/me",
          "/api/v1/workspaces",
          "/api/v1/workspaces/limits",
          "/api/v1/workspaces/personal",
          "/api/workspaces/invitations",
          "/api/v1/notifications"
        ],
        "prefix": ["/api/v1/users/", "/api/v1/user/", "/api/v1/notifications/"],
        "exclude": [
          "/api/v1/users/chatgpt",
          "/api/v1/users/me/avatar/upload",
          "/api/v1/users/me/banner/upload",
          "/api/v1/users/me/playgrounds",
          "/api/v1/users/me/password",
          "/api/v1/users/me/delete",
          "/api/v1/users/me/email",
          "/api/v1/users/me/identities"
        ]
      }
    ]
  }
}
