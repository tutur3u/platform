    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-intersection-observer": "^11.0.1",
    "react-textarea-autosize": "^8.5.9",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sanitize-filename": "^1.6.4",
    "sharp": "^0.35.5",
