{
  "appDir": "src/app",
  "api": {
    "out": "src/start-bridge/api-registry.bridge.gen.ts",
    "patternsOut": "src/start-bridge/api-patterns.bridge.gen.ts",
    "lazy": true
  },
  "pages": {
    "out": "src/start-bridge/page-registry.bridge.gen.ts"
  },
  "stripSegments": {
    "[locale]": {
      "locale": "en"
    }
  },
  "owned": {},
  "ignored": {},
  "runtime": {
    "/": {
      "redirect": "/login"
    },
    "/login": {
      "redirect": "https://tuturuuu.com/login"
    }
  },
  "runtimeProbes": {
    "page": {
      "skip": "signed-out users always reach central login",
      "fixture": "cloudflare/anonymous-smoke.runtime.mjs"
    },
    "notFound": {
      "skip": "unknown paths redirect signed-out users to login",
      "fixture": "cloudflare/anonymous-smoke.runtime.mjs"
    }
  }
}
