{
  "name": "@tuturuuu/marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "test": "vitest run --passWithNoTests",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7836} --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 7836 --turbopack",
    "messages:sync": "node scripts/sync-messages.mjs",
    "public:sync": "node scripts/sync-public.mjs",
    "messages:check": "node scripts/sync-messages.mjs --check",
    "build:cloudflare": "vp build --configLoader runner",
    "dev:cloudflare": "vp dev --configLoader runner --host 127.0.0.1 --port ${PORT:-7836}",
    "preview:cloudflare": "vp preview --configLoader runner --host 127.0.0.1 --port ${PORT:-7836}",
    "routes:check": "bun ../../packages/start-bridge/src/codegen/cli.ts check .",
    "type-check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "test:runtime": "node --test cloudflare/*.runtime.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tuturuuu/feature-flags": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/legal": "workspace:*",
    "@tuturuuu/marketing-shell": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/start-bridge": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.5.1",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.8",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "^5.0.5",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "marketing.tuturuuu",
    "script": "dev:app"
  }
}
