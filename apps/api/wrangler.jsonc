{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tuturuuu-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "limits": { "cpu_ms": 50 }
}
