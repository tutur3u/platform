{
  "name": "@tuturuuu/meet",
  "version": "0.35.0",
  "private": true,
  "scripts": {
    "type-check": "node scripts/type-check.cjs && bun run type-check:config",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- vp dev --port ${PORT:-7807}",
    "devx": "bun sb:stop && bun sb:start && bun dev",
    "devrs": "bun sb:stop && bun sb:start && bun sb:reset && bun dev",
    "build": "vp build --configLoader runner",
    "start": "vp preview",
    "preview": "vp preview",
    "stop": "cd ../database && bun sb:stop",
    "sb:status": "cd ../database && bun sb:status",
    "sb:start": "cd ../database && bun sb:start",
    "sb:stop": "cd ../database && bun sb:stop",
    "sb:sync": "cd ../database && bun sb:sync",
    "sb:reset": "cd ../database && bun sb:reset",
    "sb:diff": "cd ../database && bun sb:diff",
    "sb:new": "cd ../database && bun sb:new",
    "sb:up": "cd ../database && bun sb:up",
    "sb:typegen": "cd ../database && bun sb:typegen",
    "ui:add": "bunx shadcn-ui@latest add",
    "ui:diff": "bunx shadcn-ui@latest diff",
    "test": "vitest run",
    "build:cloudflare": "vp build --configLoader runner",
    "preview:cloudflare": "vp preview",
    "deploy:cloudflare": "wrangler deploy --config dist/ssr/wrangler.json",
    "cf:typecheck": "node scripts/type-check.cjs",
    "cf:typegen": "wrangler types --config dist/ssr/wrangler.json --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts && biome format --write cloudflare-env.d.ts",
    "type-check:config": "tsc --noEmit --project tsconfig.config.json"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "0.1.2",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@google/genai": "^2.30.0",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tuturuuu/ai": "workspace:*",
    "@tuturuuu/apis": "workspace:*",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/education-core": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/meet-core": "workspace:*",
    "@tuturuuu/realtime": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/start-bridge": "workspace:*",
    "@tuturuuu/storage-core": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/tasks-api": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "@tuturuuu/vercel": "workspace:*",
    "@types/negotiator": "^0.6.5",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "nanoid": "^6.0.2",
    "negotiator": "^1.1.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "use-intl": "4.14.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/workers-types": "5.20261022.1",
    "@opennextjs/cloudflare": "https://registry.npmjs.org/@opennextjs/cloudflare/-/cloudflare-1.20.6.tgz",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "mdast-util-from-markdown": "^2.1.0",
    "postcss": "^8.5.31",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "^5.0.5",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "meet.tuturuuu",
    "script": "dev:app"
  },
  "type": "module"
}
