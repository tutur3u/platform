{
  "extends": "@tuturuuu/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "rootDir": ".",
    "outDir": ".turbo/types/app",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": ".turbo/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/runtime",
    "src/router.tsx",
    "src/routes",
    "src/routeTree.gen.ts",
    "src/proxy.ts",
    "src/features",
    "src/hooks",
    "src/lib",
    "src/utils",
    "src/constants",
    "src/declarations.d.ts",
    "global.d.ts",
    "messages/en.json",
    "messages/vi.json",
    "src/start.ts",
    "src/app/[locale]/(auth)/login/page.tsx",
    "src/app/[locale]/[wsId]/actions.ts",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/audio-recorder.tsx",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/components/AudioPlayer.tsx",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/components/DeleteConfirmation.tsx",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/components/TranscriptViewer.tsx",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/meeting-actions.tsx",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/meeting-calendar-event.ts",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/recording-session-actions.tsx",
    "src/app/[locale]/[wsId]/meetings/[meetingId]/recording-sessions-overview.tsx",
    "src/app/[locale]/[wsId]/meetings/meetings-content.tsx",
    "src/app/[locale]/[wsId]/structure.tsx",
    "src/app/[locale]/[wsId]/workspace-context.ts",
    "src/app/[locale]/[wsId]/workspace-select.tsx",
    "src/app/[locale]/r/[code]/preview/route.tsx",
    "src/app/api/auth/logout/route.ts",
    "src/app/api/auth/refresh-app-session/route.ts",
    "src/app/api/auth/verify-app-token/route.ts",
    "src/app/api/build-info/route.ts",
    "src/app/api/meet-ai/finalize/route.ts",
    "src/app/api/meet-ai/[wsId]/[meetingId]/chunks/route.ts",
    "src/app/api/meet-ai/[wsId]/[meetingId]/followups/route.ts",
    "src/app/api/meet-ai/[wsId]/[meetingId]/route.ts",
    "src/app/api/meet-call/[meetingId]/assistant/personal/route.ts",
    "src/app/api/meet-call/[meetingId]/assistant/review/route.ts",
    "src/app/api/meet-call/[meetingId]/assistant/route.ts",
    "src/app/api/meet-call/[meetingId]/costs/route.ts",
    "src/app/api/meet-call/[meetingId]/document/route.ts",
    "src/app/api/meet-call/[meetingId]/files/route.ts",
    "src/app/api/meet-call/[meetingId]/programming/preview/[port]/[[...path]]/route.ts",
    "src/app/api/meet-call/[meetingId]/programming/route.ts",
    "src/app/api/meet-call/[meetingId]/public-info/route.ts",
    "src/app/api/meet-call/[meetingId]/recording/route.ts",
    "src/app/api/meet-call/[meetingId]/state/route.ts",
    "src/app/api/meet-call/[meetingId]/title/route.ts",
    "src/app/api/meet-call/[meetingId]/token/route.ts",
    "src/app/api/meet-live/[meetingId]/review/route.ts",
    "src/app/api/meet-live/[meetingId]/route.ts",
    "src/app/api/meet-live/memory/route.ts",
    "src/i18n/routing.ts"
  ],
  "exclude": ["node_modules", "dist", ".turbo"]
}
