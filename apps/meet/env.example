# Required environment variables
# for both development and production
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# AWS Credentials
AWS_REGION=YOUR_AWS_REGION
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
SOURCE_NAME=YOUR_SOURCE_NAME
SOURCE_EMAIL=YOUR_SOURCE_EMAIL
# Server-only staff-session verification
# TUTURUUU_AZURE_TENANT_ID

# Meet Forms requires an explicit opt-in in both Meet and Meet realtime.
MEET_FORMS_ENABLED=false
MEET_FORMS_EXTENDED_ENABLED=false
# Set the public Turnstile site key, server secret and exact requesting hostname
# before enabling submissions that require a challenge.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# MEET_FORMS_TURNSTILE_HOSTNAME=
