{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tuturuuu-cron-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-28",
  "account_id": "e8912e2867beecc673d171907bf09649",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 3 * * *",
      "0 */12 * * *",
      "0 6 * * *",
      "0 */6 * * *",
      "*/10 * * * *",
      "*/15 * * * *",
      "*/30 * * * *",
      "* * * * *"
    ]
  },
  "vars": {
    "WEB_ORIGIN": "https://tuturuuu.com",
    "INFRASTRUCTURE_ORIGIN": "https://infrastructure.tuturuuu.com",
    "INVENTORY_ORIGIN": "https://inventory.tuturuuu.com",
    "PAY_ORIGIN": "https://pay.tuturuuu.com",
    "TASKS_ORIGIN": "https://tasks.tuturuuu.com",
    "CRON_CONTROL_ENABLED_JOBS": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "CRON_LEDGER", "class_name": "CronLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CronLedger"] }],
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SECRET_KEY",
      "CRON_CONTROL_DELIVERY_TOKEN"
    ]
  }
}
