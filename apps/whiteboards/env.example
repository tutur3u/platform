# Next development template. The native Worker pins its origins in
# cloudflare/native-profiles.json and rejects mismatched configuration.
# Required environment variables for both development and production
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
TUTURUUU_APP_COORDINATION_SECRET=YOUR_APP_COORDINATION_SECRET
