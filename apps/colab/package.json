{
  "name": "@tuturuuu/colab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 7835",
    "build": "vp build && tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vp test --pool=threads",
    "preview": "vp dev --config vite.worker.config.ts",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "lint": "vp lint --config .oxlintrc.json src vite.config.ts vite.worker.config.ts --deny-warnings",
    "format:check": "vp fmt --config .oxfmtrc.json src vite.config.ts vite.worker.config.ts --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/multiplayer": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^4.20260730.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.152.0"
  }
}
