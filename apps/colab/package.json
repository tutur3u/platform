{
  "name": "@tuturuuu/colab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7835",
    "build": "vite build && tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev --port 8795",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/multiplayer": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "4",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
