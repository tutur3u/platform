    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
