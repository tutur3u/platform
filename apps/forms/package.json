{
  "name": "@tuturuuu/forms",
  "version": "0.21.0",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build && bun run type-check:cloudflare",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7828} --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 7828 --turbopack",
    "build:cloudflare": "vp build --configLoader runner",
    "dev:cloudflare": "vp dev --configLoader runner --host 127.0.0.1 --port ${PORT:-7828}",
    "preview:cloudflare": "vp preview --configLoader runner --host 127.0.0.1 --port ${PORT:-7828}",
    "routes:check": "bun ../../packages/start-bridge/src/codegen/cli.ts check .",
    "type-check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "test:runtime": "node --test cloudflare/*.runtime.mjs"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "0.1.2",
