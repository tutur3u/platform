{
  "name": "@tuturuuu/apps",
  "version": "0.25.0",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7818} --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "preview": "next build --turbopack && next start -p 7818 --turbopack",
    "build:cloudflare": "vp build",
    "test:cloudflare": "vp test --config vitest.cloudflare.config.ts && node --test cloudflare/owned-process-group.test.mjs cloudflare/runtime-deadline.test.mjs"
  },
  "dependencies": {
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "@tuturuuu/vercel": "workspace:*",
    "next": "^16.4.0",
    "next-intl": "^4.14.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "30.0.1",
    "postcss": "^8.5.28",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "4.149.0"
  },
  "packageManager": "bun@1.4.3",
  "portless": {
    "name": "apps.tuturuuu",
    "script": "dev:app"
  }
}
