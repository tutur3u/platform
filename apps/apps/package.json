{
  "name": "@tuturuuu/apps",
  "version": "0.25.1",
  "private": true,
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- vp dev --host 127.0.0.1 --port ${PORT:-7818}",
    "build": "vp build",
    "start": "vp preview --host 127.0.0.1 --port ${PORT:-7818}",
    "preview": "vp preview --host 127.0.0.1 --port ${PORT:-7818}",
    "build:cloudflare": "vp build",
    "test:cloudflare": "vp test run --config vitest.config.ts && node --test cloudflare/owned-process-group.test.mjs cloudflare/runtime-deadline.test.mjs",
    "test": "vp test run --config vitest.config.ts",
    "test:runtime": "node --test cloudflare/native-built-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/start-bridge": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.31",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "apps.tuturuuu",
    "script": "dev:app"
  }
}
