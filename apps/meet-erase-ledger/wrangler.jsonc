{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tuturuuu-meet-erase-ledger",
  "main": "src/erase-ledger-do.ts",
  "compatibility_date": "2026-08-06",
  "secrets": {
    "required": ["MEET_ERASE_LEDGER_KEY_V1", "MEET_AI_PROTECTED_WORKSPACE_IDS"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "durable_objects": {
    "bindings": [
      { "name": "MEET_ERASE_LEDGER", "class_name": "MeetEraseLedger" }
    ]
  },
  "migrations": [
    { "tag": "meet-erase-ledger-v1", "new_sqlite_classes": ["MeetEraseLedger"] }
  ],
  // Provisioning is HELD: Cora confirms retention and Selene selects a separate custody account first.
  "r2_buckets": [
    { "binding": "LEDGER_BUCKET", "bucket_name": "tuturuuu-meet-erase-ledger" }
  ]
}
