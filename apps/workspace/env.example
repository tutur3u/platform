# Required environment variables
# for both development and production
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Required to authenticate Supabase task embedding webhooks.
# Requests fail closed with a server configuration error when this is unset.
SUPABASE_WEBHOOK_SECRET=YOUR_SUPABASE_WEBHOOK_SECRET
TUTURUUU_APP_COORDINATION_SECRET=YOUR_APP_COORDINATION_SECRET

# AWS Credentials
AWS_REGION=YOUR_AWS_REGION
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
SOURCE_NAME=YOUR_SOURCE_NAME
SOURCE_EMAIL=YOUR_SOURCE_EMAIL

# Server-only staff-session verification
# TUTURUUU_AZURE_TENANT_ID

# Central Web API forwarding (leave INTERNAL_WEB_API_ORIGIN unset in production).
# A set value must be an https origin on tuturuuu.com, the built-in staging Web host or a host
# listed in TUTURUUU_WEB_API_HOSTS (comma-separated exact hostnames); anything
# else fails closed.
# INTERNAL_WEB_API_ORIGIN
# TUTURUUU_WEB_API_HOSTS
