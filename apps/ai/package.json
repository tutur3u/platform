{
  "name": "@tuturuuu/ai-studio",
  "version": "0.11.3",
  "private": true,
  "scripts": {
    "type-check": "node ../../scripts/run-tsc-build.js --build",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- next dev -p ${PORT:-7829} --turbopack",
    "build": "next build --turbopack",
    "start": "next start -p 7829",
    "test": "vitest run"
  },
  "packageManager": "bun@1.4.0",
  "portless": {
    "name": "ai.tuturuuu",
    "script": "dev:app"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.63",
    "@tanstack/react-query": "^5.102.8",
    "@tuturuuu/ai": "workspace:*",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "@tuturuuu/vercel": "workspace:*",
    "ai": "^7.0.91",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "postcss": "^8.5.26",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
