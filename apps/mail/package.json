{
  "name": "@tuturuuu/mail",
  "version": "0.30.0",
  "private": true,
  "scripts": {
    "type-check": "bun run type-check:app && bun run type-check:boundary && bun run type-check:worker",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- vp dev --host 127.0.0.1 --port 7820",
    "build": "vp build",
    "start": "vp preview --host 127.0.0.1 --port 7820",
    "preview": "vp preview --host 127.0.0.1 --port 7820",
    "sb:status": "cd ../database && bun sb:status",
    "sb:start": "cd ../database && bun sb:start",
    "sb:stop": "cd ../database && bun sb:stop",
    "sb:up": "cd ../database && bun sb:up",
    "sb:typegen": "cd ../database && bun sb:typegen",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "build:legacy": "next build --turbopack",
    "dev:legacy": "next dev -p 7820 --turbopack",
    "start:legacy": "next start -p 7820",
    "type-check:app": "tsc --noEmit --project tsconfig.json",
    "type-check:worker": "tsc --noEmit --project tsconfig.worker.json",
    "type-check:boundary": "tsc --project tsconfig.boundary.json"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "mail.tuturuuu",
    "script": "dev:app"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.102",
    "@aws-sdk/client-s3": "3.1154.0",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@tanstack/react-query": "5.104.5",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tuturuuu/ai": "workspace:*",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/email-service": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/internal-api": "workspace:*",
    "@tuturuuu/offline": "workspace:*",
    "@tuturuuu/satellite": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/types": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "@tuturuuu/vercel": "workspace:*",
    "ai": "^7.0.148",
    "cookies-next": "^6.1.1",
    "dayjs": "1.11.23",
    "docx-preview": "0.4.1",
    "mailauth": "^5.0.3",
    "negotiator": "^1.1.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "postal-mime": "4.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-router": "1.170.45",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.31",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "vite-plus": "1.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "void": "1.1.12",
    "@tailwindcss/vite": "4.3.3",
    "@cloudflare/workers-types": "5.20261022.1",
    "wrangler": "4.152.0",
    "@fontsource-variable/noto-sans": "5.3.0"
  },
  "type": "module"
}
