{
  "extends": "@tuturuuu/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmitOnError": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "incremental": false
  },
  "include": ["src/**/*", "scripts/**/*", "messages/**/*.json"],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    ".typecheck",
    "cloudflare",
    "cloudflare-env.d.ts"
  ]
}
