# Names only. Real values live in Worker secrets and are never committed.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Verifies the Passwords app-session cookie (target app: passwords)
TUTURUUU_APP_COORDINATION_SECRET=YOUR_APP_COORDINATION_SECRET
# Wraps vault data keys; the same key and AES-256-GCM envelope as the mobile vault
ENCRYPTION_MASTER_KEY=YOUR_ENCRYPTION_MASTER_KEY
# Vault work runs only when this is exactly `true`; the committed default is `false`
PASSWORDS_ENABLED=false
