{
  "name": "@tuturuuu/passwords",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "dev": "node ../../scripts/portless-safe-dev.js",
    "dev:app": "node ../../scripts/portless-dev-banner.js -- vp dev --host 127.0.0.1 --port ${PORT:-7829}",
    "build": "vp build",
    "build:cloudflare": "vp build",
    "start": "vp preview --host 127.0.0.1 --port ${PORT:-7829}",
    "preview": "vp preview --host 127.0.0.1 --port ${PORT:-7829}",
    "test": "vp test run --config vitest.config.ts",
    "test:runtime": "node --test cloudflare/native-built-worker.test.mjs"
  },
  "packageManager": "bun@1.4.4",
  "portless": {
    "name": "passwords.tuturuuu",
    "script": "dev:app"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tuturuuu/auth": "workspace:*",
    "@tuturuuu/icons": "workspace:*",
    "@tuturuuu/storage-core": "workspace:*",
    "@tuturuuu/supabase": "workspace:*",
    "@tuturuuu/ui": "workspace:*",
    "@tuturuuu/utils": "workspace:*",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@tuturuuu/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "void": "1.1.12",
    "wrangler": "4.151.2"
  }
}
