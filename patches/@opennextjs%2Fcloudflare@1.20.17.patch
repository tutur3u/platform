diff --git a/dist/cli/build/w3-patch-scheduler.js b/dist/cli/build/w3-patch-scheduler.js
new file mode 100644
index 0000000000000000000000000000000000000000..ebe9ecf29dbdc72c11007ada656d15dc5cd5d188
--- /dev/null
+++ b/dist/cli/build/w3-patch-scheduler.js
@@ -0,0 +1,16 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { parseCode, applyRule } from '@opennextjs/aws/build/patch/astCodePatcher.js';
+const rule = "\nrule:\n  pattern:\n    selector: function_declaration\n    context: \"function $FUNCTION($$$ARGS) { $$$BODY }\"\n  all:\n    - has:\n        regex: DANGEROUSLY_runPendingImmediatesAfterCurrentTask\n        stopBy: end\n    - has:\n        regex: expectNoPendingImmediates\n        stopBy: end\n    - not:\n        has:\n          kind: function_declaration\n          stopBy: end\n          has:\n            regex: DANGEROUSLY_runPendingImmediatesAfterCurrentTask\n            stopBy: end\nfix: |-\n  function $FUNCTION(first, ...rest) {\n    return globalThis.__w3Scheduler.runInSequentialTasks(first, ...rest);\n  }\n";
+export function patchWorkerScheduler(handler) {
+ const code = fs.readFileSync(handler, 'utf8');
+ if (code.includes('globalThis.__w3Scheduler')) throw Error('Scheduler already patched');
+ const root = parseCode(code);
+ const { edits } = applyRule(rule, root);
+ if (edits.length < 1) throw Error('No staged render runner matched');
+ fs.copyFileSync(handler, handler + '.w3-unpatched');
+ fs.copyFileSync(fileURLToPath(new URL('./w3-scheduler.mjs', import.meta.url)), path.join(path.dirname(handler), 'w3-scheduler.mjs'));
+ fs.writeFileSync(handler, "import * as __w3Scheduler from './w3-scheduler.mjs';\nglobalThis.__w3Scheduler=__w3Scheduler;\n" + root.commitEdits(edits));
+ console.log('Worker scheduler runner matches:', edits.length);
+}
diff --git a/dist/cli/build/w3-scheduler.mjs b/dist/cli/build/w3-scheduler.mjs
