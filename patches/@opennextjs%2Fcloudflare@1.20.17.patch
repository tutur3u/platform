index 0000000000000000000000000000000000000000..b5a06a92252b6bbfb5a38375a1988189a7c5bf7c
--- /dev/null
+++ b/dist/cli/build/w3-scheduler.mjs
@@ -0,0 +1,104 @@
+import { setImmediate as setImmediatePromise } from "node:timers/promises";
+import { promisify } from "node:util";
+const nativeSetImmediate = globalThis.setImmediate;
+const nativeSetImmediatePromise = setImmediatePromise;
+const REQUEST_CONTEXT = Symbol.for("__cloudflare-context__");
+const scopes = new WeakMap;
+const GLOBAL_QUEUE_TIMEOUT_MS = 30_000;
+const scopeOutsideRequest = { scheduledImmediates: 0, lastRender: Promise.resolve() };
+function currentScope() {
+  const context = globalThis[REQUEST_CONTEXT];
+  if (typeof context !== "object" || context === null) {
+    return scopeOutsideRequest;
+  }
+  let scope = scopes.get(context);
+  if (!scope) {
+    scope = { scheduledImmediates: 0, lastRender: Promise.resolve() };
+    scopes.set(context, scope);
+  }
+  return scope;
+}
+function countedSetImmediate(callback, ...args) {
+  currentScope().scheduledImmediates++;
+  return nativeSetImmediate(callback, ...args);
+}
+const countedSetImmediatePromise = (value, options) => {
+  currentScope().scheduledImmediates++;
+  return nativeSetImmediatePromise(value, options);
+};
+Object.defineProperty(countedSetImmediate, promisify.custom, { value: countedSetImmediatePromise });
+globalThis.setImmediate = countedSetImmediate;
+const NEXT_ORIGINALS = Symbol.for("next.fast-set-immediate.originals");
+const nextOriginals = globalThis[NEXT_ORIGINALS];
+if (nextOriginals) {
+  nextOriginals.setImmediate = countedSetImmediate;
+}
+export function runInSequentialTasks(first, ...rest) {
+  const scope = currentScope();
+  const previousRender = scope.lastRender;
+  let endRender;
+  const renderDone = new Promise((resolve) => endRender = resolve);
+  const isGlobalQueue = scope === scopeOutsideRequest;
+  // A timed-out waiter may release its own slot, but must not skip its predecessor.
+  scope.lastRender = isGlobalQueue ? previousRender.then(() => renderDone) : renderDone;
+  return new Promise((resolve, reject) => {
+    const stages = [first, ...rest];
+    let result;
+    let expired = false;
+    const timeout = isGlobalQueue ? setTimeout(() => {
+      expired = true;
+      fail(new Error("OpenNext global scheduler task timed out"));
+    }, GLOBAL_QUEUE_TIMEOUT_MS) : undefined;
+    const fail = (error) => {
+      clearTimeout(timeout);
+      endRender();
+      reject(error);
+    };
+    const afterImmediates = (next) => {
+      const scheduled = scope.scheduledImmediates;
+      nativeSetImmediate(() => {
+        if (expired) return;
+        if (scope.scheduledImmediates === scheduled) {
+          next();
+        } else {
+          afterImmediates(next);
+        }
+      });
+    };
+    const runStage = (index) => {
+      if (expired) return;
+      try {
+        const value = stages[index]();
+        if (index === 0) {
+          result = value;
+          if (isThenable(result)) {
+            result.then(noop, noop);
+          }
+        }
+      } catch (error) {
+        fail(error);
+        return;
+      }
+      afterImmediates(() => {
+        if (index + 1 < stages.length) {
+          runStage(index + 1);
+        } else {
+          endRender();
+          if (!isGlobalQueue) {
+            resolve(result);
+            return;
+          }
+          Promise.resolve(result).then((value) => {
+            clearTimeout(timeout);
+            resolve(value);
+          }, fail);
+        }
+      });
+    };
+    previousRender.then(() => nativeSetImmediate(() => runStage(0)));
+  });
+}
+function isThenable(value) {
+  return value !== null && typeof value === "object" && typeof value.then === "function";
+}
+function noop() {}
