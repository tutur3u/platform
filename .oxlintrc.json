{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "react", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "rules": { "eslint/no-alert": "error" },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/coverage/**",
    ".worktrees/**",
    "tmp/**",
    "apps/backend/**",
    "apps/tanstack-web/**",
    "apps/mobile/**"
  ]
}
