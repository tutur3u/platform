{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-alert": "off",
    "eslint/no-constant-binary-expression": "off",
    "eslint/no-control-regex": "off",
    "eslint/no-unused-expressions": "off",
    "eslint/no-unused-vars": "off",
    "jsx-a11y/anchor-has-content": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/heading-has-content": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/mouse-events-have-key-events": "off",
    "jsx-a11y/no-aria-hidden-on-focusable": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "off",
    "oxc/erasing-op": "off",
    "oxc/only-used-in-recursion": "off",
    "react-hooks/exhaustive-deps": "off",
    "react/error-boundaries": "off",
    "react/globals": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/no-children-prop": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/set-state-in-render": "off",
    "react/static-components": "off",
    "react/use-memo": "off",
    "react/void-use-memo": "off",
    "typescript/no-unnecessary-parameter-property-assignment": "off",
    "typescript/triple-slash-reference": "off",
    "react/no-danger": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/coverage/**",
    ".worktrees/**",
    "tmp/**",
    "apps/backend/**",
    "apps/tanstack-web/**",
    "apps/mobile/**",
    "**/routeTree.gen.ts",
    "**/*.bridge.gen.ts",
    "apps/api/generated/**",
    "apps/contacts/cloudflare/.void/**",
    "apps/contacts/cloudflare/package.json",
    ".agents/skills/**",
    "packages/sdk/src/operational-search/python-adapter-code.ts"
  ]
}
