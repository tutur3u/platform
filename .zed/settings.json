{
  "code_actions_on_format": {
    "source.fixAll.oxlint": true
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.turbo",
    "**/.next",
    "**/dist",
    "apps/mobile/build",
    "**/coverage",
    "**/.cache",
    "**/.dart_tool",
    "**/target",
    "**/.venv",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/__pycache__",
    "**/Pods",
    "**/playwright-report",
    "**/test-results",
    "tmp"
  ],
  "languages": {
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": [
        "typescript-ls",
        "vtsls",
        "oxlint",
        "!typescript-language-server"
      ],
      "semantic_tokens": "combined"
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": [
        "typescript-ls",
        "vtsls",
        "!typescript-language-server",
        "oxlint"
      ],
      "semantic_tokens": "combined"
    },
    "JSX": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": [
        "typescript-ls",
        "vtsls",
        "!typescript-language-server",
        "oxlint"
      ],
      "semantic_tokens": "combined"
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": [
        "typescript-ls",
        "vtsls",
        "!typescript-language-server",
        "oxlint"
      ],
      "semantic_tokens": "combined"
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"]
        }
      }
    }
  },
  "formatter": "auto"
}
